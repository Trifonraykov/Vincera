# === Vincera Bot Configuration ===

# OpenRouter API key (will be encrypted at rest after first run)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Company identity
COMPANY_NAME=MyCompany
AGENT_NAME=vincera
COMPANY_ID=

# Supabase connection (service key will be encrypted at rest)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# File system
HOME_DIR=~/VinceraHQ

# Model selection
ORCHESTRATOR_MODEL=anthropic/claude-opus-4-5
AGENT_MODEL=anthropic/claude-sonnet-4-5

# Ghost mode (days of observation before active deployment)
GHOST_MODE_DAYS=7

# =====================================================================
# === Creator x Builder platform (Next.js app at the repo root)    ===
# =====================================================================
# Copy to .env.local for local development. Validated at boot by lib/env.ts.
# Outside production, any external credential left empty makes that service
# run its fake implementation (CLAUDE.md §19.3). In production every §17
# variable below is required and fakes are forbidden.

# --- Environment ---
# APP_ENV=development|test|production. Defaults from NODE_ENV. e2e/CI set APP_ENV=test so a
# `next build && next start` server (always NODE_ENV=production) may still use fakes.
APP_ENV=
# Force fake services: "all" or a comma list of email,storage,stripe,social,ai,embeddings,jobs,ratelimit
FAKE_SERVICES=all
# Enables /api/test/* routes (never in production).
E2E_TEST_ROUTES=
# Set to 1 to read the fake emails (magic links) at /api/dev/mailbox instead of .data/outbox/.
# Anyone who can reach the dev server can then sign in as any user: only on a trusted machine.
DEV_MAILBOX=

# --- App ---
APP_NAME=Vincera
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma list of emails that get the admin role when they sign up.
ADMIN_EMAILS=admin@example.com

# --- Database (Postgres + pgvector; docs/supabase.md) ---
# Local Postgres, the Supabase CLI's (pnpm supabase:start:
# postgres://postgres:postgres@localhost:54322/postgres), or a Supabase project of its own: its
# Session pooler connection string (Connect button), e.g.
# postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# (single-quote the value if the password contains $). Docker (./launch.sh) reads DATABASE_URL,
# DATABASE_SSL, DATABASE_CA_CERT and DATABASE_POOL_MAX from a root .env file; unset, it uses its
# own Supabase Postgres container.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/creator_dev
# TLS: disable | require | verify-full. Unset: the URL's sslmode (Supabase hosts: libpq meaning,
# require encrypts without verifying the server; other hosts: node-postgres's meaning, require
# verifies), else require for *.supabase.co / *.supabase.com, else disable. Production refuses a
# remote database that is not verified, unless DATABASE_SSL=require (never for Supabase).
DATABASE_SSL=
# CA certificate the server is verified against (Supabase: Project Settings -> Database -> SSL
# Configuration -> Download certificate): PEM text (one line with \n escapes works) or a file
# path such as ./prod-ca-2021.crt. Set, the server is always verified (verify-full); production
# requires it for Supabase hosts.
DATABASE_CA_CERT=
# Connections per app process (1-100). Keep it small on serverless hosting.
DATABASE_POOL_MAX=10
# pnpm db:migrate refuses, untouched, a database holding another app's tables or functions (the
# hardening would change them); 1 migrates and hardens it anyway. Give the platform its own.
# DATABASE_ALLOW_FOREIGN_OBJECTS=1
# Maintenance connection used by integration tests to create per-run template databases.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Database reset, migrated and seeded before each Playwright run.
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/creator_e2e

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Encryption at rest (AES-256-GCM, lib/crypto.ts) ---
# 32 random bytes, base64. Dev only: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Vincera <noreply@example.com>"

# --- Stripe (test mode outside production) ---
STRIPE_SECRET_KEY=
# Always required: fake Stripe signs its webhooks with it. `pnpm stripe:listen` prints a real one.
STRIPE_WEBHOOK_SECRET=whsec_dev_fake_secret_change_me
# Signing secret of the Connect webhook endpoint (account.updated, capability.updated).
# Required in production. Optional elsewhere: falls back to STRIPE_WEBHOOK_SECRET (fake Stripe and
# `pnpm stripe:listen` sign Connect events with that one).
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Social data connections (separate from login) ---
# Each provider's redirect URI is <NEXT_PUBLIC_APP_URL>/api/oauth/<provider>/callback
# (youtube, instagram, tiktok, github). A provider without credentials runs its fake.
GOOGLE_YT_CLIENT_ID=
GOOGLE_YT_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GITHUB_DATA_CLIENT_ID=
GITHUB_DATA_CLIENT_SECRET=
# Providers whose OAuth app can't be used yet (e.g. Meta or TikTok review pending), comma list such
# as "instagram,tiktok". Their Connect buttons are hidden, creators enter numbers by hand instead,
# and their credentials are not required in production (CLAUDE.md §19.14).
SOCIAL_OAUTH_DISABLED=
# Keep YouTube statistics longer than 30 days. Only once Google has accepted the platform under
# its derived-metrics policy (CLAUDE.md §19.10); while false, a daily job deletes older snapshots.
YOUTUBE_LONG_RETENTION=false

# --- AI ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
EMBEDDINGS_PROVIDER=voyage
VOYAGE_API_KEY=

# --- Storage (Cloudflare R2, S3 API) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Jobs (Inngest) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
SENTRY_DSN=
# Build-time only: uploads source maps when set (with SENTRY_ORG / SENTRY_PROJECT).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Business rules ---
PLATFORM_TAKE_RATE=0.10
HOLD_DAYS=14
MIN_PAYOUT_CENTS=1000
AUTO_APPROVE_LAUNCHES=false
# Matching v1 (CLAUDE.md §19.38): pin the ranking model (v0, or v1-<YYYY-MM-DD>); empty = the
# matching_config row marked active. MATCHING_V1_FORCE=true lets v1 rank before 50 launches went
# live (development and tests only; refused in production).
MATCHING_MODEL_VERSION=
MATCHING_V1_FORCE=false

# --- Service adapters (CLAUDE.md §19.7) ---
# Voyage embedding model; must support 1024-dim output (output_dimension=1024).
VOYAGE_MODEL=voyage-3.5
# Local Inngest dev server instead of inline jobs: set INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY
# (any values) and uncomment. Never in production: dev mode skips request signatures, so
# lib/env.ts refuses to start with it.
# INNGEST_DEV=1
